# ======================================================================
# Viky configuration — copy to `.env` and edit. Nothing is hardcoded;
# switching DEV -> PROD should require ONLY changes in this file.
# ======================================================================

# ---- General ----------------------------------------------------------
VIKY_ENV=dev                 # dev | prod
VIKY_LOG_LEVEL=INFO
VIKY_DRY_RUN=true            # tools log instead of executing (keep true in dev)

# ---- Service networking ----------------------------------------------
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=8000
STT_HOST=127.0.0.1
STT_PORT=8001
TTS_HOST=127.0.0.1
TTS_PORT=8002
# Under docker-compose these are set to service names, e.g.:
# STT_BASE_URL=http://stt:8001
# TTS_BASE_URL=http://tts:8002
STT_BASE_URL=
TTS_BASE_URL=

# ---- STT (faster-whisper) --------------------------------------------
# DEV (RTX 3060 Ti, 8 GB): medium/int8. PROD (EVO-X2): large-v3/int8.
WHISPER_MODEL=medium
WHISPER_COMPUTE=int8
WHISPER_DEVICE=auto          # auto | cpu | cuda
WHISPER_LANGUAGE=cs
# VAD (silero)
VAD_SILENCE_MS=800
VAD_THRESHOLD=0.5

# ---- TTS (Piper, CPU) -------------------------------------------------
# Viky = female voice. Female CZ: cs_CZ-kasandra-medium. Male alt: cs_CZ-jirka-medium.
PIPER_VOICE=cs_CZ-kasandra-medium
PIPER_VOICE_PATH=            # path to the .onnx voice; empty = auto-download dir
PIPER_BINARY=piper
TTS_SAMPLE_RATE=22050

# ---- Wake word (openWakeWord) ----------------------------------------
# Leave model path empty and fallback=true until viky.onnx is trained.
VIKY_WAKEWORD_MODEL=
VIKY_WAKEWORD_FALLBACK=true
VIKY_WAKEWORD_FALLBACK_NAME=hey_jarvis
VIKY_WAKEWORD_THRESHOLD=0.5

# ---- LLM (via LiteLLM, OpenAI-compatible) ----------------------------
# DEV: Claude API. PROD: local Qwen3 via LM Studio/Ollama.
# LLM_MODEL needs a LiteLLM provider prefix.
#   DEV example:
#     LLM_MODEL=anthropic/claude-sonnet-4-5
#     LLM_API_KEY=sk-ant-...        (or set ANTHROPIC_API_KEY for LiteLLM)
#   PROD example (local, OpenAI-compatible):
#     LLM_MODEL=openai/qwen3-30b-a3b
#     LLM_API_BASE=http://localhost:1234/v1
#     LLM_API_KEY=not-needed
LLM_MODEL=anthropic/claude-sonnet-4-5
LLM_API_BASE=
LLM_API_KEY=
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=1024

# ---- Audio I/O (sounddevice) -----------------------------------------
AUDIO_INPUT_DEVICE=          # empty = system default; else index or name
AUDIO_OUTPUT_DEVICE=
AUDIO_SAMPLE_RATE=16000

# ---- Orchestrator state machine --------------------------------------
LISTEN_TIMEOUT_S=8
FOLLOWUP_WINDOW_S=5
VIKY_LOGS_DIR=logs

# ---- Tool endpoints ---------------------------------------------------
N8N_WEBHOOK_BASE=http://localhost:5678/webhook
STATS_API_BASE=http://localhost:8010
